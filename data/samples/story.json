      "snapshot_id": "fixture-2026-10-10-v1",
      "entry_id": "entry:bridge",
      "text": "现在可以公布我的家人信息了。",
      "speaker_id": "person:helper",
      "source_id": "source:fixture",
      "source_locator": "data/samples/story.json#/passages/25",
      "required_scope_ids": [
        "opening",
