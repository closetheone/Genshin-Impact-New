      "id": "passage:27",
      "snapshot_id": "fixture-2026-10-10-v1",
      "entry_id": "entry:bridge",
      "text": "接下来的两段材料用于模拟仅限站内展示的用途。",
      "speaker_id": null,
      "source_id": "source:fixture",
      "source_locator": "data/samples/story.json#/passages/26",
      "required_scope_ids": [
