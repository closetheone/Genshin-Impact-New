      ]
    },
    {
      "id": "passage:29",
      "snapshot_id": "fixture-2026-10-10-v1",
      "entry_id": "entry:bridge",
      "text": "我的师父是阿宁。",
      "speaker_id": "person:merchant",
      "source_id": "source:internal",
      "source_locator": "data/samples/story.json#/passages/28",
      "required_scope_ids": [
        "opening",
