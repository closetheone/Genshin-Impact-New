    },
    {
      "id": "passage:30",
      "snapshot_id": "fixture-2026-10-10-v1",
      "entry_id": "entry:bridge",
      "text": "记录员仅记下木匠青禾与商人青禾同场出现，不能据此推断合作。",
      "speaker_id": null,
      "source_id": "source:fixture",
      "source_locator": "data/samples/story.json#/passages/29",
      "required_scope_ids": [
        "opening",
