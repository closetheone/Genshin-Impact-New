      "snapshot_id": "fixture-2026-10-10-v1",
      "entry_id": "entry:bridge",
      "text": "名册记载：木匠青禾的孩子是阿宁。",
      "speaker_id": null,
      "source_id": "source:fixture",
      "source_locator": "data/samples/story.json#/passages/24",
      "required_scope_ids": [
        "opening",
        "later"
