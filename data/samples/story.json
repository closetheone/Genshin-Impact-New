    },
    {
      "id": "passage:28",
      "snapshot_id": "fixture-2026-10-10-v1",
      "entry_id": "entry:bridge",
      "text": "商人青禾是我的徒弟。",
      "speaker_id": "person:helper",
      "source_id": "source:internal",
      "source_locator": "data/samples/story.json#/passages/27",
      "required_scope_ids": [
        "opening",
        "later"
      ],
      "branch_id": null,
      "next_ids": [
